{
  "runtime": "canvas-v1",
  "name": "Video Player",
  "description": "Plays a local or live video resource with deliberate playback and presentation controls.",
  "version": "0.1.7",
  "entry": "dist/assets/addon.js",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "2",
  "ui": {
    "pointerEvents": "auto"
  },
  "settings": [
    {
      "id": "source",
      "type": "section",
      "label": "Source"
    },
    {
      "id": "video",
      "type": "resource",
      "label": "Video",
      "description": "Choose a local video file or enter a live URL.",
      "parent": "source",
      "scope": "layer"
    },
    {
      "id": "playback",
      "type": "section",
      "label": "Playback"
    },
    {
      "id": "autoplay",
      "type": "boolean",
      "label": "Autoplay",
      "parent": "playback",
      "scope": "layer",
      "default": true
    },
    {
      "id": "loop",
      "type": "boolean",
      "label": "Loop",
      "parent": "playback",
      "scope": "layer",
      "default": true
    },
    {
      "id": "muted",
      "type": "boolean",
      "label": "Muted",
      "description": "Most browsers require muted playback for autoplay.",
      "parent": "playback",
      "scope": "layer",
      "default": true
    },
    {
      "id": "showControls",
      "type": "boolean",
      "label": "Show controls",
      "parent": "playback",
      "scope": "layer",
      "default": false
    },
    {
      "id": "clickToToggle",
      "type": "boolean",
      "label": "Click to play or pause",
      "parent": "playback",
      "scope": "layer",
      "default": true
    },
    {
      "id": "volume",
      "type": "range",
      "label": "Volume",
      "parent": "playback",
      "scope": "layer",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "playbackRate",
      "type": "range",
      "label": "Playback speed",
      "parent": "playback",
      "scope": "layer",
      "default": 1,
      "min": 0.25,
      "max": 2,
      "step": 0.25
    },
    {
      "id": "startAtSeconds",
      "type": "number",
      "label": "Start at (seconds)",
      "parent": "playback",
      "scope": "layer",
      "default": 0,
      "min": 0,
      "max": 86400,
      "step": 1
    },
    {
      "id": "preload",
      "type": "select",
      "label": "Preload",
      "parent": "playback",
      "scope": "layer",
      "default": "metadata",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Metadata", "value": "metadata" },
        { "label": "Automatic", "value": "auto" }
      ]
    },
    {
      "id": "display",
      "type": "section",
      "label": "Display"
    },
    {
      "id": "objectFit",
      "type": "select",
      "label": "Fit",
      "parent": "display",
      "scope": "layer",
      "default": "contain",
      "options": [
        { "label": "Contain", "value": "contain" },
        { "label": "Cover", "value": "cover" },
        { "label": "Stretch", "value": "fill" }
      ]
    },
    {
      "id": "borderRadius",
      "type": "range",
      "label": "Corner radius",
      "parent": "display",
      "scope": "layer",
      "default": 24,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "backgroundColor",
      "type": "color",
      "label": "Background",
      "parent": "display",
      "scope": "layer",
      "alpha": true,
      "default": "#0c0c0dff"
    }
  ]
}
